# ─────────────────────────────────────
# Supabase
# ─────────────────────────────────────
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ─────────────────────────────────────
# LLM provider
#   ollama  -> local Llama 3 via ChatOllama
#   openai  -> GPT-4o via ChatOpenAI
# Switching providers is a single change here — no code changes.
# ─────────────────────────────────────
LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3
OPENAI_MODEL=gpt-4o

# ─────────────────────────────────────
# Embeddings (OpenAI, used in BOTH dev and prod)
# ─────────────────────────────────────
OPENAI_API_KEY=
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536

# ─────────────────────────────────────
# Ingestion / retrieval tuning
# ─────────────────────────────────────
CHUNK_SIZE=800
CHUNK_OVERLAP=150
RETRIEVAL_TOP_K=10
RETRIEVAL_RERANK_TOP_K=5
SIMILARITY_THRESHOLD=0.65

# ─────────────────────────────────────
# Draft generation constraints
# ─────────────────────────────────────
MAX_DRAFT_WORDS=200
MIN_DRAFT_WORDS=80

# ═════════════════════════════════════
# Module 2 — Platform connections
# ═════════════════════════════════════

# Generate with:  python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TOKEN_ENCRYPTION_KEY=
APP_BASE_URL=http://localhost:8000
FRONTEND_URL=http://localhost:3000

# Reddit — reddit.com/prefs/apps (script app)
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_REDIRECT_URI=http://localhost:8000/connections/reddit/callback
REDDIT_USER_AGENT=AI Dialogue Enhancer/1.0

# Bluesky — bsky.app/settings/app-passwords
BLUESKY_HANDLE=
BLUESKY_APP_PASSWORD=

# Mastodon — {instance}/settings/applications
MASTODON_CLIENT_ID=
MASTODON_CLIENT_SECRET=
MASTODON_REDIRECT_URI=http://localhost:8000/connections/mastodon/callback
MASTODON_INSTANCE_URL=https://mastodon.social

# Discord — discord.com/developers/applications
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_BOT_TOKEN=
DISCORD_REDIRECT_URI=http://localhost:8000/connections/discord/callback

# Telegram — message @BotFather, /newbot
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=

# Threads — developers.facebook.com (Threads product)
THREADS_APP_ID=
THREADS_APP_SECRET=
THREADS_REDIRECT_URI=http://localhost:8000/connections/threads/callback

# YouTube — console.cloud.google.com (YouTube Data API v3)
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REDIRECT_URI=http://localhost:8000/connections/youtube/callback

# ═════════════════════════════════════
# Module 4 — Post discovery & scoring
# (fallbacks only — the discovery_settings DB row is authoritative)
# ═════════════════════════════════════
DISCOVERY_ENABLED=true
DISCOVERY_SCHEDULE_MINUTES=30
MAX_POSTS_PER_RUN=50
MAX_CONVERSATIONS_PER_DAY=5
MIN_RELEVANCE_SCORE=0.65
